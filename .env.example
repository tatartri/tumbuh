# ==============================================================================
# TEMPLAT KONFIGURASI ENVIRONMENT TUMBUH
# Salin berkas ini menjadi .env lalu sesuaikan nilainya dengan konfigurasi lokal.
# ==============================================================================

# Port Server Aplikasi Express
PORT=3000
NODE_ENV=development

# Konfigurasi Koneksi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=tumbuh_db
DB_CONNECTION_LIMIT=10

# Rahasia JWT (JSON Web Token) untuk Autentikasi
JWT_SECRET=ganti_dengan_kunci_rahasia_acak_panjang_dan_aman_minimal_32_karakter
JWT_EXPIRES_IN=7d
